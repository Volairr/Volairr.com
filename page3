<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>Volairr — Watch Europe go on sale, live</title>
<meta name="description" content="A live departures board for cheap flights. Volairr flips through the lowest fares from your airports the moment they drop — and pings you before everyone else." />
<meta name="theme-color" content="#070C16" />
<meta property="og:title" content="Volairr — Watch Europe go on sale, live" />
<meta property="og:description" content="Check in for early access. The cheapest flights across Europe, on a live departures board." />
<link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 88'%3E%3Cpath d='M49 70C34 58 20 40 10 14c11 16 24 28 33 39 3 5 5 11 6 17z' fill='%232563EB'/%3E%3Cpath d='M51 70c15-12 29-30 39-56-11 16-24 28-33 39-3 5-5 11-6 17z' fill='%2338BDF8'/%3E%3C/svg%3E" />
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link rel="preconnect" href="https://api.fontshare.com" crossorigin />
<link href="https://api.fontshare.com/v2/css?f[]=satoshi@900,700,500&display=swap" rel="stylesheet" />
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@500;700;800&display=swap" rel="stylesheet" />

<!-- HOW TO EDIT: deals → search "EDIT: deals" · signup → "EDIT: signup" · colours → :root -->

<style>
  :root{
    --bg:#070C16;--bg-2:#0A1322;--navy:#0F172A;
    --royal:#2563EB;--sky:#38BDF8;--cyan:#22D3EE;--emerald:#34D399;--amber:#F5B642;
    --txt:#EEF3FA;--muted:#93A4BC;--muted-2:#5A6B85;
    --glass:rgba(255,255,255,.045);--glass-bd:rgba(255,255,255,.10);
    --grad:linear-gradient(135deg,#3B82F6 0%,#38BDF8 55%,#22D3EE 100%);
    --maxw:1140px;--display:'Satoshi','Inter',sans-serif;--body:'Inter',-apple-system,sans-serif;--mono:'JetBrains Mono',ui-monospace,Menlo,monospace;
  }
  *{margin:0;padding:0;box-sizing:border-box}
  html{scroll-behavior:smooth}
  body{font-family:var(--body);background:var(--bg);color:var(--txt);line-height:1.6;-webkit-font-smoothing:antialiased;overflow-x:hidden}
  a{color:inherit;text-decoration:none}svg{display:block}button{font-family:inherit;cursor:pointer;border:none;background:none}
  .wrap{max-width:var(--maxw);margin:0 auto;padding:0 24px;position:relative;z-index:2}
  h1,h2,h3,.disp{font-family:var(--display);font-weight:900;letter-spacing:-.025em;line-height:1.04}
  .grad-text{background:var(--grad);-webkit-background-clip:text;background-clip:text;-webkit-text-fill-color:transparent}

  /* atmosphere */
  .sky{position:fixed;inset:0;z-index:0;pointer-events:none;background:radial-gradient(80% 50% at 50% -10%,rgba(56,189,248,.16),transparent 60%),radial-gradient(60% 50% at 12% 8%,rgba(37,99,235,.16),transparent 55%),radial-gradient(70% 60% at 92% 22%,rgba(34,211,238,.10),transparent 55%),linear-gradient(180deg,#070C16,#0A1322 60%,#070C16)}
  .stars{position:fixed;inset:0;z-index:0;pointer-events:none}
  .stars i{position:absolute;width:2px;height:2px;border-radius:50%;background:#fff;opacity:.5;animation:tw 4s infinite ease-in-out}
  @keyframes tw{0%,100%{opacity:.16}50%{opacity:.85}}

  .logo{display:flex;align-items:center;gap:11px}
  .logo .mark{width:32px;height:28px;filter:drop-shadow(0 0 9px rgba(56,189,248,.5))}
  .logo .name{font-family:var(--display);font-weight:700;font-size:23px;color:#fff}

  .btn{font-family:var(--display);font-weight:700;font-size:15px;cursor:pointer;border:none;border-radius:13px;padding:13px 22px;transition:transform .2s,box-shadow .25s,background .25s;white-space:nowrap;display:inline-flex;align-items:center;gap:9px}
  .btn-grad{background:var(--grad);color:#04121f;box-shadow:0 0 0 1px rgba(255,255,255,.14),0 14px 38px -10px rgba(56,189,248,.6)}
  .btn-grad:hover{transform:translateY(-2px);box-shadow:0 0 0 1px rgba(255,255,255,.25),0 22px 56px -12px rgba(56,189,248,.85)}
  .btn-glass{background:var(--glass);color:#fff;border:1px solid var(--glass-bd);backdrop-filter:blur(10px)}
  .btn-glass:hover{transform:translateY(-2px);background:rgba(255,255,255,.1)}

  /* nav */
  header{position:fixed;top:0;left:0;right:0;z-index:120;padding:20px 0;transition:.4s;border-bottom:1px solid transparent}
  header.scrolled{background:rgba(7,12,22,.72);backdrop-filter:blur(18px);border-color:var(--glass-bd);padding:13px 0}
  .nav{display:flex;align-items:center;justify-content:space-between;gap:24px}
  .nav-links{display:flex;align-items:center;gap:30px}
  .nav-links a{font-size:15px;font-weight:500;color:var(--muted);transition:.2s}.nav-links a:hover{color:#fff}

  /* hero */
  .hero{padding:150px 0 80px;text-align:center;position:relative}
  .eyebrow{display:inline-flex;align-items:center;gap:9px;font-family:var(--mono);font-size:12px;font-weight:700;letter-spacing:.14em;text-transform:uppercase;color:var(--sky);background:rgba(56,189,248,.09);border:1px solid rgba(56,189,248,.25);padding:7px 15px;border-radius:100px;margin-bottom:26px}
  .eyebrow .dot{width:7px;height:7px;border-radius:50%;background:var(--emerald);box-shadow:0 0 9px var(--emerald);animation:blink 1.6s infinite}
  @keyframes blink{0%,100%{opacity:1}50%{opacity:.3}}
  h1{font-size:clamp(40px,6.4vw,74px);font-weight:900;color:#fff;max-width:14ch;margin:0 auto 20px}
  .hero-sub{font-size:clamp(16px,2vw,20px);color:var(--muted);max-width:560px;margin:0 auto 40px}

  /* split-flap board */
  .board{max-width:760px;margin:0 auto;background:linear-gradient(180deg,#0c1424,#070b14);border:1px solid rgba(255,255,255,.08);border-radius:20px;padding:18px 20px 22px;box-shadow:0 50px 110px -40px rgba(0,0,0,.85),0 0 60px -20px rgba(245,182,66,.18),inset 0 1px 0 rgba(255,255,255,.05);overflow-x:auto}
  .board-bar{display:flex;align-items:center;justify-content:space-between;gap:12px;padding-bottom:14px;margin-bottom:14px;border-bottom:1px solid rgba(255,255,255,.07);font-family:var(--mono);font-size:12px;font-weight:700;letter-spacing:.12em;color:var(--muted-2);text-transform:uppercase}
  .board-bar .ttl{color:var(--amber);display:flex;align-items:center;gap:9px}
  .board-bar .ttl svg{width:15px;height:14px}
  .board-bar .clock{color:#fff;display:flex;align-items:center;gap:8px;letter-spacing:.1em}
  .board-bar .clock .lv{width:7px;height:7px;border-radius:50%;background:var(--emerald);box-shadow:0 0 8px var(--emerald);animation:blink 1.6s infinite}
  .board-cols{display:flex;gap:12px;padding:0 2px 8px;font-family:var(--mono);font-size:10.5px;font-weight:700;letter-spacing:.1em;color:var(--muted-2);min-width:max-content}
  .board-cols .l-from{width:calc(3*var(--cw) + 2*3px)}
  .board-cols .l-dest{width:calc(9*var(--cw) + 8*3px)}
  .board-cols .l-price{width:calc(4*var(--cw) + 3*3px);text-align:right}
  .board-cols .l-save{width:calc(4*var(--cw) + 3*3px);text-align:right}
  #flaps{display:flex;flex-direction:column;gap:6px;min-width:max-content}
  .frow{display:flex;gap:12px;align-items:center}
  .fg{display:flex;gap:3px}
  :root{--cw:25px;--ch:35px}
  .flap{position:relative;width:var(--cw);height:var(--ch);display:flex;align-items:center;justify-content:center;background:linear-gradient(#1b2740,#0f1a2e);border-radius:4px;font-family:var(--mono);font-weight:800;font-size:19px;color:var(--amber);box-shadow:inset 0 0 0 1px rgba(255,255,255,.05),0 1px 2px rgba(0,0,0,.5);text-shadow:0 0 8px rgba(245,182,66,.35)}
  .flap::after{content:"";position:absolute;left:1px;right:1px;top:50%;height:1px;background:rgba(0,0,0,.6);transform:translateY(-.5px)}
  .flap.f{animation:flip .12s ease}
  @keyframes flip{0%{transform:scaleY(1)}45%{transform:scaleY(.55);filter:brightness(1.5)}100%{transform:scaleY(1)}}
  .fg-price .flap,.fg-save .flap{color:#fff;text-shadow:0 0 8px rgba(255,255,255,.3)}
  .fg-save .flap{color:var(--emerald);text-shadow:0 0 8px rgba(52,211,153,.4)}
  .hero-cta{margin-top:38px;display:flex;gap:14px;justify-content:center;flex-wrap:wrap}
  .scrollcue{margin-top:30px;font-family:var(--mono);font-size:11px;letter-spacing:.16em;text-transform:uppercase;color:var(--muted-2)}

  .reveal{opacity:0;transform:translateY(26px);transition:opacity .7s,transform .7s}
  .reveal.in{opacity:1;transform:none}
  .d1{transition-delay:.06s}.d2{transition-delay:.14s}.d3{transition-delay:.22s}

  section{padding:104px 0;position:relative;z-index:2}
  .sec-head{max-width:620px;margin:0 auto 54px;text-align:center}
  .tag{font-family:var(--mono);font-size:12px;font-weight:700;letter-spacing:.14em;text-transform:uppercase;color:var(--sky);margin-bottom:16px;display:inline-block}
  h2{font-size:clamp(30px,4.6vw,48px);font-weight:900;color:#fff;margin-bottom:18px}
  .sec-head p{font-size:18px;color:var(--muted)}

  /* boarding pass */
  .pass-wrap{max-width:860px;margin:0 auto;perspective:1400px}
  .pass{display:grid;grid-template-columns:1fr 230px;background:linear-gradient(135deg,#fbfdff,#eef3fb);border-radius:22px;overflow:hidden;box-shadow:0 50px 110px -40px rgba(0,0,0,.7),0 0 70px -30px rgba(56,189,248,.4);position:relative}
  .pass-main{padding:30px 34px;position:relative}
  .pass-brand{display:flex;align-items:center;gap:10px;margin-bottom:24px}
  .pass-brand .name{font-family:var(--display);font-weight:700;font-size:20px;color:var(--navy)}
  .pass-brand .mark{width:26px;height:23px}
  .pass-route{display:flex;align-items:center;gap:18px;margin-bottom:26px}
  .pass-route .pt{font-family:var(--display);font-weight:900;font-size:30px;color:var(--navy);line-height:1}
  .pass-route .pt small{display:block;font-family:var(--mono);font-size:11px;font-weight:700;color:var(--muted-2);letter-spacing:.1em;margin-top:6px}
  .pass-route .pa{flex:1;position:relative;height:24px}
  .pass-route .pa::before{content:"";position:absolute;top:50%;left:0;right:0;height:2px;background:repeating-linear-gradient(90deg,#9fb4d0 0 5px,transparent 5px 11px)}
  .pass-route .pa svg{position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);color:var(--royal)}
  .pass-fields{display:grid;grid-template-columns:1.6fr 1fr;gap:18px}
  .pf .k{font-family:var(--mono);font-size:10px;font-weight:700;letter-spacing:.12em;text-transform:uppercase;color:var(--muted-2);margin-bottom:5px}
  .pf .v{font-family:var(--mono);font-weight:700;font-size:15px;color:var(--navy)}
  .checkin-row{margin-top:24px;display:flex;gap:10px}
  .checkin-row input{flex:1;font-family:var(--body);font-size:15px;padding:13px 16px;border-radius:11px;border:1px solid #cfdcec;background:#fff;color:var(--navy)}
  .checkin-row input:focus{outline:none;border-color:var(--royal);box-shadow:0 0 0 4px rgba(37,99,235,.12)}
  .btn-board{background:var(--navy);color:#fff;border-radius:11px;padding:13px 22px;font-family:var(--display);font-weight:700;font-size:15px;transition:.2s}
  .btn-board:hover{background:#1c2b46;transform:translateY(-2px)}
  .pass-stub{background:linear-gradient(160deg,#0f1d36,#0a1424);color:#fff;padding:30px 24px;display:flex;flex-direction:column;justify-content:space-between;position:relative}
  .pass-stub::before{content:"";position:absolute;left:-11px;top:0;bottom:0;width:22px;background:radial-gradient(circle at left,transparent 0 10px,#eef3fb 10px) ;background-size:22px 22px;background-repeat:repeat-y}
  .stub-k{font-family:var(--mono);font-size:10px;font-weight:700;letter-spacing:.12em;text-transform:uppercase;color:var(--muted);margin-bottom:6px}
  .stub-seat{font-family:var(--display);font-weight:900;font-size:40px;color:#fff;line-height:.9}
  .stub-seat span{font-size:15px;color:var(--sky)}
  .barcode{height:46px;margin-top:18px;background:repeating-linear-gradient(90deg,#fff 0 2px,transparent 2px 3px,#fff 3px 4px,transparent 4px 7px,#fff 7px 11px,transparent 11px 12px);opacity:.92;border-radius:3px}
  .pass-stamp{position:absolute;top:28px;right:28px;border:3px solid var(--emerald);color:var(--emerald);font-family:var(--display);font-weight:900;font-size:18px;letter-spacing:.08em;padding:7px 14px;border-radius:8px;transform:rotate(-14deg) scale(.6);opacity:0;transition:.5s cubic-bezier(.2,1.4,.4,1)}
  .pass.checked .pass-stamp{opacity:1;transform:rotate(-14deg) scale(1)}
  .checkin-note{display:none;margin-top:18px;font-family:var(--mono);font-size:12.5px;color:var(--emerald);letter-spacing:.04em}
  .pass.checked .checkin-row{display:none}.pass.checked .checkin-note{display:block}

  /* radar */
  .radar-grid{display:grid;grid-template-columns:1fr 1fr;gap:50px;align-items:center;max-width:980px;margin:0 auto}
  .radar{position:relative;width:330px;height:330px;margin:0 auto;border-radius:50%;background:radial-gradient(circle,rgba(52,211,153,.06),transparent 70%);border:1px solid rgba(52,211,153,.18)}
  .radar .ring{position:absolute;border-radius:50%;border:1px solid rgba(52,211,153,.14);top:50%;left:50%;transform:translate(-50%,-50%)}
  .r1{width:80%;height:80%}.r2{width:55%;height:55%}.r3{width:28%;height:28%}
  .radar .cross{position:absolute;background:rgba(52,211,153,.12)}
  .cx{top:50%;left:0;right:0;height:1px;transform:translateY(-.5px)}.cy{left:50%;top:0;bottom:0;width:1px;transform:translateX(-.5px)}
  .sweep{position:absolute;inset:0;border-radius:50%;background:conic-gradient(from 0deg,rgba(52,211,153,.45),rgba(52,211,153,.08) 24%,transparent 42%);animation:spin 4s linear infinite;mask:radial-gradient(circle,#000 70%,transparent 71%);-webkit-mask:radial-gradient(circle,#000 70%,transparent 71%)}
  @keyframes spin{to{transform:rotate(360deg)}}
  .blip{position:absolute;width:9px;height:9px;border-radius:50%;background:var(--emerald);box-shadow:0 0 12px var(--emerald);transform:translate(-50%,-50%);animation:ping 4s infinite}
  @keyframes ping{0%,18%,100%{opacity:.25;transform:translate(-50%,-50%) scale(.7)}8%{opacity:1;transform:translate(-50%,-50%) scale(1.5)}}
  .blip.b1{top:30%;left:62%;animation-delay:.4s}.blip.b2{top:64%;left:40%;animation-delay:1.4s}.blip.b3{top:46%;left:74%;animation-delay:2.2s}.blip.b4{top:72%;left:66%;animation-delay:3s}.blip.b5{top:26%;left:38%;animation-delay:1.9s}.blip.b6{top:54%;left:24%;animation-delay:.9s}
  .radar-copy h2{text-align:left}
  .radar-list{margin-top:22px;display:flex;flex-direction:column;gap:11px}
  .rl{display:flex;align-items:center;gap:13px;font-size:15px;color:var(--muted)}
  .rl .ri{width:38px;height:38px;border-radius:11px;background:rgba(52,211,153,.1);border:1px solid rgba(52,211,153,.22);display:flex;align-items:center;justify-content:center;color:var(--emerald);flex:none}
  .rl b{color:#fff;font-weight:600}

  /* explorer */
  .explorer{max-width:900px;margin:0 auto;text-align:center}
  .exp-num{font-family:var(--display);font-weight:900;font-size:clamp(54px,9vw,96px);color:#fff;line-height:1;margin-bottom:8px}
  .exp-num span{background:var(--grad);-webkit-background-clip:text;background-clip:text;-webkit-text-fill-color:transparent}
  .exp-count{font-size:16px;color:var(--muted);margin-bottom:30px}
  .exp-count b{color:var(--emerald)}
  .slider-wrap{max-width:480px;margin:0 auto 44px}
  input[type=range]{-webkit-appearance:none;width:100%;height:6px;border-radius:100px;background:linear-gradient(90deg,#22D3EE,#2563EB);outline:none}
  input[type=range]::-webkit-slider-thumb{-webkit-appearance:none;width:26px;height:26px;border-radius:50%;background:#fff;cursor:pointer;box-shadow:0 0 0 5px rgba(56,189,248,.4),0 2px 10px rgba(0,0,0,.5)}
  input[type=range]::-moz-range-thumb{width:26px;height:26px;border-radius:50%;background:#fff;border:none;cursor:pointer;box-shadow:0 0 0 5px rgba(56,189,248,.4)}
  .slider-scale{display:flex;justify-content:space-between;font-family:var(--mono);font-size:11px;color:var(--muted-2);margin-top:9px;letter-spacing:.06em}
  .dest-cloud{display:flex;flex-wrap:wrap;gap:11px;justify-content:center}
  .dest-chip{display:flex;align-items:center;gap:9px;background:var(--glass);border:1px solid var(--glass-bd);border-radius:100px;padding:10px 17px;transition:.3s;backdrop-filter:blur(8px)}
  .dest-chip .city{font-weight:600;font-size:14.5px;color:#fff}
  .dest-chip .pr{font-family:var(--mono);font-weight:700;font-size:13px;color:var(--emerald)}
  .dest-chip.off{opacity:.28;filter:grayscale(.6) blur(.4px);transform:scale(.94)}

  /* how */
  .steps{position:relative;display:grid;grid-template-columns:repeat(3,1fr);gap:24px;max-width:980px;margin:0 auto}
  .route-line{position:absolute;top:32px;left:16%;right:16%;height:2px;background:repeating-linear-gradient(90deg,rgba(56,189,248,.5) 0 6px,transparent 6px 14px)}
  .step{position:relative;z-index:1;text-align:center;padding:0 12px}
  .step .ic{width:66px;height:66px;border-radius:50%;background:var(--bg-2);border:1px solid var(--glass-bd);display:flex;align-items:center;justify-content:center;color:var(--sky);margin:0 auto 20px;box-shadow:0 0 0 6px rgba(56,189,248,.06)}
  .step h3{font-size:20px;color:#fff;margin-bottom:9px}.step p{font-size:15px;color:var(--muted);max-width:260px;margin:0 auto}

  /* pricing */
  .price-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:22px;align-items:stretch;max-width:980px;margin:0 auto}
  .plan{position:relative;background:var(--glass);border:1px solid var(--glass-bd);border-radius:22px;padding:32px 28px;display:flex;flex-direction:column;backdrop-filter:blur(12px);transition:.35s}
  .plan:hover{transform:translateY(-6px);border-color:rgba(56,189,248,.35)}
  .plan.feat{background:linear-gradient(180deg,rgba(37,99,235,.2),rgba(34,211,238,.05));box-shadow:0 36px 80px -34px rgba(56,189,248,.5);transform:translateY(-8px)}
  .plan.feat::before{content:"";position:absolute;inset:0;border-radius:22px;padding:1.5px;background:var(--grad);-webkit-mask:linear-gradient(#fff 0 0) content-box,linear-gradient(#fff 0 0);-webkit-mask-composite:xor;mask-composite:exclude;pointer-events:none}
  .badge{position:absolute;top:-13px;left:50%;transform:translateX(-50%);font-family:var(--mono);font-size:11px;font-weight:700;letter-spacing:.1em;text-transform:uppercase;color:#04121f;background:var(--grad);padding:6px 14px;border-radius:100px}
  .pcls{font-family:var(--mono);font-size:11px;font-weight:700;letter-spacing:.14em;text-transform:uppercase;color:var(--sky);margin-bottom:10px}
  .pname{font-family:var(--display);font-weight:900;font-size:23px;color:#fff;margin-bottom:18px}
  .pprice{display:flex;align-items:baseline;gap:4px;margin-bottom:24px}
  .pprice .amt{font-family:var(--display);font-weight:900;font-size:42px;color:#fff}
  .pprice .per{font-size:14px;color:var(--muted)}
  .plan ul{list-style:none;flex:1;margin-bottom:26px}
  .plan li{display:flex;gap:11px;align-items:flex-start;font-size:14.5px;padding:8px 0;color:#DCE6F2}
  .plan li svg{flex:none;margin-top:3px;color:var(--sky)}
  .plan .btn{width:100%;justify-content:center}

  /* footer */
  footer{padding:56px 0 36px;border-top:1px solid var(--glass-bd);position:relative;z-index:2}
  .foot-top{display:flex;justify-content:space-between;gap:36px;flex-wrap:wrap;padding-bottom:32px;border-bottom:1px solid var(--glass-bd)}
  .foot-brand{max-width:300px}.foot-brand .logo{margin-bottom:13px}.foot-brand p{font-size:14px;color:var(--muted)}
  .foot-tag{font-family:var(--display);font-weight:700;color:var(--sky);font-size:14px;margin-top:11px}
  .foot-cols{display:flex;gap:56px;flex-wrap:wrap}
  .foot-col h5{font-family:var(--mono);font-size:11px;font-weight:700;letter-spacing:.1em;text-transform:uppercase;color:var(--muted-2);margin-bottom:14px}
  .foot-col a{display:block;font-size:14px;color:var(--muted);padding:5px 0}.foot-col a:hover{color:var(--sky)}
  .foot-bottom{display:flex;justify-content:space-between;gap:12px;flex-wrap:wrap;padding-top:24px;font-family:var(--mono);font-size:12px;color:var(--muted-2)}

  @media(max-width:860px){
    .nav-links{display:none}
    .pass{grid-template-columns:1fr}.pass-stub::before{display:none}.pass-stub{flex-direction:row;align-items:center;justify-content:space-between}.barcode{display:none}
    .radar-grid{grid-template-columns:1fr;gap:36px}.radar-copy h2{text-align:center}.radar-list{max-width:360px;margin:22px auto 0}
    .steps,.price-grid{grid-template-columns:1fr;max-width:420px}.route-line{display:none}.plan.feat{transform:none}
    :root{--cw:21px;--ch:30px}.flap{font-size:16px}
  }
  @media(max-width:520px){
