<script>
  var reduce=window.matchMedia&&window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  /* stars */
  (function(){var s=document.getElementById('stars'),h='';for(var i=0;i<60;i++){h+='<i style="left:'+(Math.random()*100).toFixed(2)+'%;top:'+(Math.random()*100).toFixed(2)+'%;width:'+(Math.random()*1.4+1).toFixed(1)+'px;height:'+(Math.random()*1.4+1).toFixed(1)+'px;animation-delay:'+(Math.random()*4).toFixed(2)+'s"></i>'}s.innerHTML=h})();

  /* nav */
  var hdr=document.getElementById('hdr');
  function onScroll(){window.scrollY>40?hdr.classList.add('scrolled'):hdr.classList.remove('scrolled')}
  window.addEventListener('scroll',onScroll,{passive:true});onScroll();

  /* reveals */
  var io=new IntersectionObserver(function(es){es.forEach(function(e){if(e.isIntersecting){e.target.classList.add('in');io.unobserve(e.target)}})},{threshold:.12,rootMargin:'0px 0px -40px 0px'});
  document.querySelectorAll('.reveal').forEach(function(el){io.observe(el)});

  /* live clock */
  function tick(){var d=new Date();var h=('0'+d.getHours()).slice(-2),m=('0'+d.getMinutes()).slice(-2);var c=document.getElementById('clock');if(c)c.textContent=h+(d.getSeconds()%2?' ':':')+m}
  tick();setInterval(tick,1000);

  /* ===== SPLIT-FLAP BOARD ===== */
  /* EDIT: deals — {from, dest(≤9 chars), price, save} */
  var DEALS=[
    {from:'AMS',dest:'LISBON',price:'€48',save:'-56%'},
    {from:'EIN',dest:'BARCELONA',price:'€29',save:'-65%'},
    {from:'BRU',dest:'ROME',price:'€55',save:'-49%'},
    {from:'EIN',dest:'PORTO',price:'€27',save:'-69%'},
    {from:'AMS',dest:'ATHENS',price:'€69',save:'-59%'},
    {from:'RTM',dest:'FARO',price:'€55',save:'-60%'},
    {from:'BRU',dest:'MARRAKECH',price:'€79',save:'-58%'},
    {from:'AMS',dest:'PRAGUE',price:'€40',save:'-57%'},
    {from:'EIN',dest:'BUDAPEST',price:'€33',save:'-65%'},
    {from:'BRU',dest:'NICE',price:'€72',save:'-55%'},
    {from:'AMS',dest:'SPLIT',price:'€59',save:'-58%'},
    {from:'EIN',dest:'KRAKOW',price:'€31',save:'-66%'},
    {from:'BRU',dest:'VIENNA',price:'€64',save:'-57%'},
    {from:'RTM',dest:'MADRID',price:'€58',save:'-56%'},
    {from:'EIN',dest:'MALAGA',price:'€39',save:'-64%'}
  ];
  var CH=' ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789€-%.';
  var COLS=[{k:'from',n:3,a:'L'},{k:'dest',n:9,a:'L'},{k:'price',n:4,a:'R'},{k:'save',n:4,a:'R'}];
  var ROWS=5,rows=[];
  function pad(s,n,a){s=(s||'').toString().toUpperCase().slice(0,n);while(s.length<n){a==='R'?s=' '+s:s=s+' '}return s}
  function build(){
    var b=document.getElementById('flaps');
    for(var r=0;r<ROWS;r++){
      var row=document.createElement('div');row.className='frow';var ref={};
      COLS.forEach(function(col){var g=document.createElement('div');g.className='fg fg-'+col.k;var cells=[];for(var i=0;i<col.n;i++){var c=document.createElement('div');c.className='flap';c.textContent=' ';g.appendChild(c);cells.push(c)}row.appendChild(g);ref[col.k]=cells});
      b.appendChild(row);rows.push(ref);
    }
  }
  function flap(cell,target){
    if(reduce){cell.textContent=target;return}
    var steps=5+Math.floor(Math.random()*9),i=0;clearInterval(cell._t);
    cell._t=setInterval(function(){i++;if(i>=steps){clearInterval(cell._t);cell.textContent=target}else{cell.textContent=CH[Math.floor(Math.random()*CH.length)]}cell.classList.remove('f');void cell.offsetWidth;cell.classList.add('f')},45);
  }
  function setGroup(cells,str){for(var i=0;i<cells.length;i++){(function(i){setTimeout(function(){flap(cells[i],str[i]||' ')},i*40)})(i)}}
  function setRow(ref,d){COLS.forEach(function(col){setGroup(ref[col.k],pad(d[col.k],col.n,col.a))})}
  var off=0;
  function show(){for(var r=0;r<ROWS;r++){(function(r){setTimeout(function(){setRow(rows[r],DEALS[(off+r)%DEALS.length])},r*140)})(r)}off=(off+ROWS)%DEALS.length}
  build();show();if(!reduce)setInterval(show,5000);

  /* ===== BOARDING PASS ===== */
  function checkIn(e){
    e.preventDefault();
    var email=document.getElementById('email-checkin').value;
    document.getElementById('pass-name').textContent=email.toUpperCase();
    document.getElementById('pass').classList.add('checked');
    return false;
  }

  /* ===== BUDGET EXPLORER ===== */
  var slider=document.getElementById('budget-slider'),chips=document.querySelectorAll('.dest-chip');
  function explore(){
    var v=+slider.value,n=0;
    document.getElementById('budget').textContent='€'+v;
    chips.forEach(function(c){var p=+c.dataset.price;if(p<=v){c.classList.remove('off');n++}else{c.classList.add('off')}});
    document.getElementById('count').textContent=n;
  }
  slider.addEventListener('input',explore);explore();
</script>
